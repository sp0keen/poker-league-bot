# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID владельца(ев) бота, через запятую — единолично подтверждают турниры,
# правят/удаляют данные, могут делать /backup и /restore
ADMIN_IDS=

# Канал, куда публикуются протоколы завершённых турниров (@username или числовой ID). Необязательно.
CHANNEL_ID=

# Веб-табло турнира (scoreboard.js). Публичный адрес, по которому оно открывается снаружи, — без
# него кнопки "📺 Табло" в закрепе нет. Домен не нужен: https://<ip-через-дефисы>.sslip.io + Caddy
SCOREBOARD_URL=
# где слушает сервер табло (снаружи к нему ходят через Caddy, поэтому по умолчанию только localhost)
SCOREBOARD_PORT=8080
SCOREBOARD_HOST=127.0.0.1
